// Prisma schema for the multi-tenant Project Management backend.
//
// Naming convention: the database uses snake_case for every table and column
// (via @map / @@map), while the Prisma Client API stays camelCase. So app code
// keeps writing `firstName`, `workspaceId`, etc., and the physical columns are
// `first_name`, `workspace_id`, ...
//
// Multi-tenancy strategy: shared database, shared schema, discriminator column.
// Every workspace-scoped table carries `workspaceId` (workspace_id) and is
// always queried with that filter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MembershipStatus {
  invited
  active
  removed

  @@map("membership_status")
}

enum StatusCategory {
  todo
  in_progress
  ready_qa
  review
  done

  @@map("status_category")
}

// Project kind chosen at creation. HubSpot projects get default modules + seed
// tasks auto-provisioned; Dev projects start empty.
enum ProjectMode {
  HubSpot
  Dev

  @@map("project_mode")
}

// ---------------------------------------------------------------------------
// Identity (global, not workspace-scoped)
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  email     String? // intentionally NOT unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  ownedProjects    Project[]         @relation("ProjectOwner")
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")

  @@index([username])
  @@map("user")
}

// OTP challenge records for passwordless login.
model OtpRequest {
  id           String    @id @default(uuid())
  username     String
  otpCodeHash  String    @map("otp_code_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([username, createdAt])
  @@map("otp_request")
}

// ---------------------------------------------------------------------------
// Workspace (tenant root)
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members        WorkspaceMember[]
  roles          UserRole[]
  permissions    UserPermission[]
  plans          Plan[]
  projects       Project[]
  modules        Module[]
  ticketStatuses TicketStatus[]
  priorities     Priority[]

  @@index([ownerId])
  @@map("workspace")
}

model WorkspaceMember {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  roleId      String           @map("role_id")
  status      MembershipStatus @default(active)
  joinedAt    DateTime         @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole  @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_member")
}

// ---------------------------------------------------------------------------
// Roles & Permissions (per workspace)
// ---------------------------------------------------------------------------

model UserRole {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  isDefault   Boolean @default(false) @map("is_default")
  isSystem    Boolean @default(false) @map("is_system")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions  RolePermission[]
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("user_role")
}

model UserPermission {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  code        String
  description String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@map("user_permission")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       UserRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission UserPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Plans (one active plan per workspace)
// ---------------------------------------------------------------------------

model Plan {
  id                String  @id @default(uuid())
  workspaceId       String  @map("workspace_id")
  name              String
  maxProjects       Int     @default(3) @map("max_projects")
  maxMembers        Int     @default(5) @map("max_members")
  maxTasksPerModule Int     @default(10) @map("max_tasks_per_module")
  features          Json    @default("{}")
  isActive          Boolean @default(true) @map("is_active")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  modules   Module[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("plan")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  name        String
  mode        ProjectMode @default(Dev)
  description String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  ownerId     String    @map("owner_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  members         ProjectMember[]
  moduleInstances ModuleInstance[]
  tasks           Task[]

  @@index([workspaceId])
  @@index([ownerId])
  @@map("project")
}

model ProjectMember {
  id        String           @id @default(uuid())
  projectId String           @map("project_id")
  userId    String           @map("user_id")
  roleId    String           @map("role_id")
  invitedBy String?          @map("invited_by")
  status    MembershipStatus @default(invited)
  joinedAt  DateTime         @default(now()) @map("joined_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    UserRole @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_member")
}

// ---------------------------------------------------------------------------
// Modules: catalog (Module) + per-project instance (ModuleInstance)
// ---------------------------------------------------------------------------

model Module {
  id               String  @id @default(uuid())
  workspaceId      String  @map("workspace_id")
  planId           String  @map("plan_id")
  key              String
  name             String
  defaultTaskLimit Int     @default(10) @map("default_task_limit")
  isDefault        Boolean @default(false) @map("is_default")
  isActive         Boolean @default(true) @map("is_active")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  instances ModuleInstance[]

  // A module belongs to a plan; the same key may exist under different plans.
  @@unique([planId, key])
  @@index([workspaceId])
  @@index([planId])
  @@map("module")
}

model ModuleInstance {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  moduleId  String   @map("module_id")
  taskLimit Int      @map("task_limit")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id])
  tasks   Task[]

  @@unique([projectId, moduleId])
  @@index([projectId])
  @@map("module_instance")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  moduleInstanceId String?   @map("module_instance_id")
  name             String
  description      String?
  startDate        DateTime? @map("start_date")
  dueDate          DateTime? @map("due_date")
  statusId         String?   @map("status_id")
  priorityId       String?   @map("priority_id")
  assigneeId       String?   @map("assignee_id")
  createdBy        String    @map("created_by")
  position         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleInstance ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  status         TicketStatus?   @relation(fields: [statusId], references: [id])
  priority       Priority?       @relation(fields: [priorityId], references: [id])
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator        User            @relation("TaskCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([moduleInstanceId])
  @@index([statusId])
  @@index([priorityId])
  @@map("task")
}

// ---------------------------------------------------------------------------
// Priorities (per workspace, configurable list)
// ---------------------------------------------------------------------------

model Priority {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  color       String?
  order       Int     @default(0)
  isDefault   Boolean @default(false) @map("is_default")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("priority")
}

// ---------------------------------------------------------------------------
// Ticket statuses (per workspace, configurable pipeline)
// ---------------------------------------------------------------------------

model TicketStatus {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  name        String
  color       String?
  order       Int            @default(0)
  isDefault   Boolean        @default(false) @map("is_default")
  category    StatusCategory @default(todo)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("ticket_status")
}
