PORT=3000
FRONTEND_REDIRECT_URL=http://localhost:4000
CORS=http://localhost:4000;http://localhost:3000
BACKEND_URL=http://localhost:3000/api/v1

# --- Database (used to build DATABASE_URL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=project_ops

# Prisma connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_ops?schema=public

# --- JWT ---
JWT_SECRET=change_me_in_production
JWT_IDENTITY_EXPIRATION=15m
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_EXPIRATION=7d

# --- OTP ---
OTP_TTL_SECONDS=604800 # 7 days
OTP_MAX_ATTEMPTS=5

NODE_ENV=development

# --- mail ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_smtp_login
BREVO_SMTP_PASSWORD=your_smtp_password
MAIL_FROM="ProjectOps <no-reply@projectops.com>"

# --- attachments (S3) — see docs/aws-s3-setup.md ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
