// Prisma schema for the multi-tenant Project Management backend.
//
// Naming convention: the database uses snake_case for every table and column
// (via @map / @@map), while the Prisma Client API stays camelCase. So app code
// keeps writing `firstName`, `workspaceId`, etc., and the physical columns are
// `first_name`, `workspace_id`, ...
//
// Multi-tenancy strategy: shared database, shared schema, discriminator column.
// Every workspace-scoped table carries `workspaceId` (workspace_id) and is
// always queried with that filter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MembershipStatus {
  invited
  active
  removed

  @@map("membership_status")
}

enum StatusCategory {
  new
  todo
  in_progress
  ready_qa
  review
  done
  blocked
  removed

  @@map("status_category")
}

enum WorkTypeCategory {
  task
  incident
  bug

  @@map("work_type_category")
}

// ---------------------------------------------------------------------------
// Identity (global, not workspace-scoped)
// ---------------------------------------------------------------------------

model User {
  id                             String    @id @default(uuid())
  // Login identifier. Required + unique — replaces the old username field.
  email                          String    @unique
  firstName                      String?   @map("first_name")
  lastName                       String?   @map("last_name")
  // Fixed OTP code for this user (defaults to the dev static code). When set,
  // OtpService issues this value instead of a random one — override per user
  // to give a tester/demo account a predictable login code.
  staticOtp                      String?   @default("123456") @map("static_otp")
  isActive                       Boolean   @default(true) @map("is_active")
  isVerified                     Boolean   @default(true) @map("is_verified")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")
  // Set once the user finishes or skips the onboarding product tour;
  // null means it hasn't been shown/completed yet.
  productTourCompletedAt         DateTime? @map("product_tour_completed_at")
  isTourDone                     Boolean   @default(false) @map("is_tour_done")
  // Same pattern, for the second (project-overview) tour.
  projectOverviewTourCompletedAt DateTime? @map("project_overview_tour_completed_at")
  isProjectOverviewTourDone      Boolean   @default(false) @map("is_project_overview_tour_done")

  ownedWorkspaces     Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers    WorkspaceMember[]
  projectMembers      ProjectMember[]
  ownedProjects       Project[]         @relation("ProjectOwner")
  activityLogs        ActivityLog[]     @relation("ActivityLogActor")
  comments            Comment[]         @relation("CommentAuthor")
  commentMentions     CommentMention[]  @relation("CommentMentions")
  assignedWorkItems   WorkItem[]        @relation("WorkItemAssignee")
  qaAssignedWorkItems WorkItem[]        @relation("WorkItemQaAssignee")
  createdWorkItems    WorkItem[]        @relation("WorkItemCreator")
  timeLogs            TimeLog[]
  attachments         Attachment[]

  @@map("user")
}

// OTP challenge records for passwordless login.
model OtpRequest {
  id           String    @id @default(uuid())
  email        String
  otpCodeHash  String    @map("otp_code_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("otp_request")
}

// ---------------------------------------------------------------------------
// Workspace (tenant root)
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner          User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members        WorkspaceMember[]
  roles          UserRole[]
  permissions    UserPermission[]
  plans          Plan[]
  projects       Project[]
  modules        Module[]
  ticketStatuses TicketStatus[]
  priorities     Priority[]
  workTypes      WorkType[]
  projectTypes   ProjectType[]
  comments       Comment[]
  activityLogs   ActivityLog[]
  timeLogs       TimeLog[]
  attachments    Attachment[]
  preference     WorkspacePreference?

  @@index([ownerId])
  @@map("workspace")
}

model WorkspaceMember {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  roleId      String           @map("role_id")
  status      MembershipStatus @default(active)
  isDefault   Boolean          @default(false) @map("is_default")
  // The member's own display-theme preference for this workspace. Self-service
  // only — any active member may read/set their own, unrestricted by role.
  theme       ThemeMode        @default(system)
  themeColor  ThemeColor       @default(blue) @map("theme_color")
  joinedAt    DateTime         @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole  @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_member")
}

enum ThemeMode {
  light
  dark
  system

  @@map("theme_mode")
}

enum ThemeColor {
  blue
  green
  purple
  red
  orange
  pink
  gray
  yellow

  @@map("theme_color")
}

// ---------------------------------------------------------------------------
// Roles & Permissions (per workspace)
// ---------------------------------------------------------------------------

model UserRole {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  isDefault   Boolean @default(false) @map("is_default")
  isSystem    Boolean @default(false) @map("is_system")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions  RolePermission[]
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("user_role")
}

model UserPermission {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  code        String
  description String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@map("user_permission")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       UserRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission UserPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Plans (one active plan per workspace)
// ---------------------------------------------------------------------------

model Plan {
  id            String  @id @default(uuid())
  workspaceId   String  @map("workspace_id")
  projectTypeId String  @map("project_type_id")
  name          String
  features      Json    @default("{}")
  isActive      Boolean @default(true) @map("is_active")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectType ProjectType @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)
  modules     Module[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@index([projectTypeId])
  @@map("plan")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  name          String
  projectTypeId String?   @map("project_type_id")
  // Plans the project is created under. Scalar list (Postgres text[]) — ids are
  // validated in the service layer; no FK relation is possible on a list.
  planId        String[]  @default([]) @map("plan_ids")
  description   String?
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  ownerId       String    @map("owner_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  projectType     ProjectType?     @relation(fields: [projectTypeId], references: [id])
  members         ProjectMember[]
  moduleInstances ModuleInstance[]
  workItems       WorkItem[]
  timeLogs        TimeLog[]
  attachments     Attachment[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([projectTypeId])
  @@map("project")
}

/**
 * A file uploaded to a project (stored in S3 — see AttachmentsModule/S3Service).
 * `s3Key` is the object key, never exposed to the client; downloads are
 * streamed back through the API rather than a signed S3 URL.
 */
model Attachment {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  s3Key       String   @map("s3_key")
  uploadedBy  String   @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploadedBy], references: [id])

  @@index([workspaceId])
  @@index([projectId])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Project types (per workspace, chosen at project creation)
// ---------------------------------------------------------------------------

model ProjectType {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  description String?
  color       String?
  // When false, creating a project of this type skips the plan quota check,
  // module attachment and seed-task creation (a bare project).
  isPlanAdd   Boolean @default(true) @map("is_plan_add")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plans     Plan[]
  projects  Project[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("project_type")
}

model ProjectMember {
  id        String           @id @default(uuid())
  projectId String           @map("project_id")
  userId    String           @map("user_id")
  roleId    String           @map("role_id")
  invitedBy String?          @map("invited_by")
  status    MembershipStatus @default(invited)
  joinedAt  DateTime         @default(now()) @map("joined_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    UserRole @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_member")
}

// ---------------------------------------------------------------------------
// Modules: catalog (Module) + per-project instance (ModuleInstance)
// ---------------------------------------------------------------------------

model Module {
  id               String  @id @default(uuid())
  workspaceId      String  @map("workspace_id")
  planId           String  @map("plan_id")
  key              String
  name             String
  defaultTaskLimit Int     @default(10) @map("default_task_limit")
  isDefault        Boolean @default(false) @map("is_default")
  isActive         Boolean @default(true) @map("is_active")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  instances ModuleInstance[]

  // A module belongs to a plan; the same key may exist under different plans.
  @@unique([planId, key])
  @@index([workspaceId])
  @@index([planId])
  @@map("module")
}

model ModuleInstance {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  moduleId  String   @map("module_id")
  taskLimit Int      @map("task_limit")
  // Count of tasks created beyond taskLimit (billable/tracked add-ons instead
  // of a hard rejection).
  addonTask Int      @default(0) @map("addon_task")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module    Module     @relation(fields: [moduleId], references: [id])
  workItems WorkItem[]

  @@unique([projectId, moduleId])
  @@index([projectId])
  @@map("module_instance")
}

// ---------------------------------------------------------------------------
// Work items (the actual units of work — tasks/incidents/bugs — classified by
// a WorkType and placed under a project's module instance)
// ---------------------------------------------------------------------------

model WorkItem {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  moduleInstanceId String?   @map("module_instance_id")
  workItemTypeId   String?   @map("work_item_type_id")
  name             String
  prefix           String?
  startDate        DateTime? @map("start_date")
  dueDate          DateTime? @map("due_date")
  statusId         String?   @map("status_id")
  priorityId       String?   @map("priority_id")
  assigneeId       String?   @map("assignee_id")
  qaAssigneeId     String?   @map("qa_assignee_id")
  createdBy        String    @map("created_by")
  estimateHours    Float?    @map("estimate_hours")
  completedHours   Float?    @map("completed_hours")
  /**
   * Flat ordering across the whole project (not per column) — see the Kanban
   * board's drag-and-drop reordering. A gap-based (fractional-indexing)
   * value: inserting between two rows only ever assigns the moved row a
   * value between its new neighbors, so a drag never needs to renumber
   * every other row in the column — see task-board.tsx's handleDragEnd.
   * Defaults to 0 for pre-existing rows; `createdAt` breaks ties so their
   * visual order is unaffected.
   */
  position         Float     @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleInstance ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  workItemType   WorkType?       @relation(fields: [workItemTypeId], references: [id])
  status         TicketStatus?   @relation(fields: [statusId], references: [id])
  priority       Priority?       @relation(fields: [priorityId], references: [id])
  assignee       User?           @relation("WorkItemAssignee", fields: [assigneeId], references: [id])
  qaAssignee     User?           @relation("WorkItemQaAssignee", fields: [qaAssigneeId], references: [id])
  creator        User            @relation("WorkItemCreator", fields: [createdBy], references: [id])
  comments       Comment[]
  timeLogs       TimeLog[]
  detail         WorkItemDetail?

  @@index([projectId])
  @@index([moduleInstanceId])
  @@index([workItemTypeId])
  @@index([statusId])
  @@index([priorityId])
  @@index([assigneeId])
  @@index([qaAssigneeId])
  @@index([projectId, position])
  @@map("work_item")
}

/**
 * A WorkItem's freeform description, split into its own 1:1 table (vertical
 * partitioning) — it's the one large, optional column on WorkItem, read only
 * by the single-item detail view. Keeping it out of `work_item` means every
 * List/Kanban fetch (which never renders it) no longer pulls it off disk.
 */
model WorkItemDetail {
  workItemId  String   @id @map("work_item_id")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("work_item_detail")
}

// ---------------------------------------------------------------------------
// Comments (workspace-scoped, with @mentions by email)
// ---------------------------------------------------------------------------

model Comment {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  // When set, this comment belongs to a specific work item instead of being a
  // standalone workspace comment.
  workItemId  String?  @map("work_item_id")
  body        String
  authorId    String   @map("author_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem  WorkItem?        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author    User             @relation("CommentAuthor", fields: [authorId], references: [id])
  mentions  CommentMention[]

  @@index([workspaceId])
  @@index([workItemId])
  @@map("comment")
}

// Users tagged in a comment (resolved from their email at creation time).
model CommentMention {
  commentId String @map("comment_id")
  userId    String @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentMentions", fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mention")
}

// ---------------------------------------------------------------------------
// Priorities (per workspace, configurable list)
// ---------------------------------------------------------------------------

model Priority {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  color       String?
  order       Int     @default(0)
  isDefault   Boolean @default(false) @map("is_default")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("priority")
}

// ---------------------------------------------------------------------------
// Work types (per workspace, categorizes tasks/incidents/bugs)
// ---------------------------------------------------------------------------

model WorkType {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  name        String
  color       String?
  category    WorkTypeCategory
  isActive    Boolean          @default(true) @map("is_active")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("work_type")
}

// ---------------------------------------------------------------------------
// Ticket statuses (per workspace, configurable pipeline)
// ---------------------------------------------------------------------------

model TicketStatus {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  name        String
  color       String?
  order       Int            @default(0)
  isDefault   Boolean        @default(false) @map("is_default")
  canDelete   Boolean        @default(true) @map("can_delete")
  category    StatusCategory @default(todo)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("ticket_status")
}

// ---------------------------------------------------------------------------
// Activity log (generic audit trail; entityType/entityId identify the subject)
// ---------------------------------------------------------------------------

/**
 * Horizontally partitioned (RANGE on createdAt, monthly) — see the
 * partition_activity_log migration. Pure insert-only audit trail with
 * unbounded growth, so Postgres can prune/scan by month and old partitions
 * can be archived or dropped independently. Postgres requires the partition
 * key in every unique constraint, so `id` alone can no longer be `@id` —
 * `(id, createdAt)` is the composite primary key instead. Nothing in this
 * codebase updates or deletes an ActivityLog row (it's append-only), so this
 * has no ripple on `id`-keyed lookups elsewhere.
 */
model ActivityLog {
  id          String   @default(uuid())
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  // What kind of thing this entry is about, e.g. 'comment'.
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  // 'created' | 'updated' | 'status_changed' | 'deleted' | 'comment_added'
  action      String
  userId      String   @map("user_id")
  // Action-specific details, e.g. { changes: { statusId: { from, to } } }.
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation("ActivityLogActor", fields: [userId], references: [id])

  @@id([id, createdAt])
  @@index([workspaceId])
  @@index([entityType, entityId])
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Time logs (manual entries or timer sessions against a work item)
// ---------------------------------------------------------------------------

enum TimeLogBillingType {
  billable
  non_billable

  @@map("time_log_billing_type")
}

enum TimeLogSource {
  manual
  timer

  @@map("time_log_source")
}

/**
 * Horizontally partitioned (RANGE on `date`, monthly) — see the
 * partition_time_log migration. Append-heavy with an explicit date column
 * already used for report/export date-range scans. Same PK caveat as
 * ActivityLog: Postgres requires the partition key in every unique
 * constraint, so `(id, date)` is the composite primary key instead of a bare
 * `id`. Unlike ActivityLog, this table IS mutated (edit/delete an entry,
 * stop a running timer) — those call sites look the row up by `id_date`
 * instead of `id` alone; see stopTimer/update/remove below.
 */
model TimeLog {
  id              String             @default(uuid())
  workspaceId     String             @map("workspace_id")
  projectId       String             @map("project_id")
  workItemId      String             @map("work_item_id")
  userId          String             @map("user_id")
  date            DateTime           @map("log_date") @db.Date
  startTime       DateTime?          @map("start_time")
  // Null while a timer-sourced entry is still running.
  endTime         DateTime?          @map("end_time")
  durationMinutes Int                @map("duration_minutes")
  billingType     TimeLogBillingType @default(billable) @map("billing_type")
  source          TimeLogSource      @default(manual)
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([id, date])
  @@index([workspaceId])
  @@index([projectId])
  @@index([workItemId])
  @@index([userId])
  @@map("time_log")
}

// ---------------------------------------------------------------------------
// Workspace preferences (currently: time-log restrictions). One row per
// workspace, created lazily on first save — a missing row means defaults.
// ---------------------------------------------------------------------------

enum TimeLogPastLimitUnit {
  day
  week
  month

  @@map("time_log_past_limit_unit")
}

model WorkspacePreference {
  id                    String               @id @default(uuid())
  workspaceId           String               @unique @map("workspace_id")
  // Whether members can add manual (non-timer) time log entries at all.
  allowManualTimeLog    Boolean              @default(true) @map("allow_manual_time_log")
  // Whether a log entry may be dated before today. Off by default: until an
  // admin opts in, members can only log time against today's date.
  allowPastTimeLog      Boolean              @default(false) @map("allow_past_time_log")
  // How far back a past-dated entry may go, in `pastTimeLogLimitUnit` units.
  // Null means unlimited (only meaningful while allowPastTimeLog is true).
  pastTimeLogLimitValue Int?                 @map("past_time_log_limit_value")
  pastTimeLogLimitUnit  TimeLogPastLimitUnit @default(day) @map("past_time_log_limit_unit")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_preference")
}
