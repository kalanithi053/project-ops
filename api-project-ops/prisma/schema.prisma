// Prisma schema for the multi-tenant Project Management backend.
//
// Naming convention: the database uses snake_case for every table and column
// (via @map / @@map), while the Prisma Client API stays camelCase. So app code
// keeps writing `firstName`, `workspaceId`, etc., and the physical columns are
// `first_name`, `workspace_id`, ...
//
// Multi-tenancy strategy: shared database, shared schema, discriminator column.
// Every workspace-scoped table carries `workspaceId` (workspace_id) and is
// always queried with that filter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MembershipStatus {
  invited
  active
  removed

  @@map("membership_status")
}

enum StatusCategory {
  new
  todo
  in_progress
  ready_qa
  review
  done
  blocked
  @@map("status_category")
}

enum IncidentStatus {
  open
  in_progress
  resolved

  @@map("incident_status")
}

// ---------------------------------------------------------------------------
// Identity (global, not workspace-scoped)
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  // Login identifier. Required + unique — replaces the old username field.
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  // Fixed OTP code for this user (defaults to the dev static code). When set,
  // OtpService issues this value instead of a random one — override per user
  // to give a tester/demo account a predictable login code.
  staticOtp String?  @default("123456") @map("static_otp")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  ownedProjects    Project[]         @relation("ProjectOwner")
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  reportedIncidents Incident[]       @relation("IncidentReporter")
  assignedIncidents Incident[]       @relation("IncidentAssignee")
  activityLogs      ActivityLog[]    @relation("ActivityLogActor")
  comments          Comment[]        @relation("CommentAuthor")
  commentMentions   CommentMention[] @relation("CommentMentions")

  @@map("user")
}

// OTP challenge records for passwordless login.
model OtpRequest {
  id           String    @id @default(uuid())
  email        String
  otpCodeHash  String    @map("otp_code_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("otp_request")
}

// ---------------------------------------------------------------------------
// Workspace (tenant root)
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members        WorkspaceMember[]
  roles          UserRole[]
  permissions    UserPermission[]
  plans          Plan[]
  projects       Project[]
  modules        Module[]
  ticketStatuses TicketStatus[]
  priorities     Priority[]
  projectTypes   ProjectType[]
  incidents      Incident[]
  comments       Comment[]
  activityLogs   ActivityLog[]

  @@index([ownerId])
  @@map("workspace")
}

model WorkspaceMember {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  roleId      String           @map("role_id")
  status      MembershipStatus @default(active)
  isDefault   Boolean          @default(false) @map("is_default")
  joinedAt    DateTime         @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole  @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_member")
}

// ---------------------------------------------------------------------------
// Roles & Permissions (per workspace)
// ---------------------------------------------------------------------------

model UserRole {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  isDefault   Boolean @default(false) @map("is_default")
  isSystem    Boolean @default(false) @map("is_system")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions  RolePermission[]
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("user_role")
}

model UserPermission {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  code        String
  description String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@map("user_permission")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       UserRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission UserPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Plans (one active plan per workspace)
// ---------------------------------------------------------------------------

model Plan {
  id                String  @id @default(uuid())
  workspaceId       String  @map("workspace_id")
  projectTypeId     String  @map("project_type_id")
  name              String
  features          Json    @default("{}")
  isActive          Boolean @default(true) @map("is_active")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectType ProjectType @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)
  modules     Module[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@index([projectTypeId])
  @@map("plan")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  name          String
  projectTypeId String?   @map("project_type_id")
  // Plans the project is created under. Scalar list (Postgres text[]) — ids are
  // validated in the service layer; no FK relation is possible on a list.
  planId        String[]  @default([]) @map("plan_ids")
  description   String?
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  ownerId       String    @map("owner_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  projectType     ProjectType?     @relation(fields: [projectTypeId], references: [id])
  members         ProjectMember[]
  moduleInstances ModuleInstance[]
  tasks           Task[]
  incidents       Incident[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([projectTypeId])
  @@map("project")
}

// ---------------------------------------------------------------------------
// Project types (per workspace, chosen at project creation)
// ---------------------------------------------------------------------------

model ProjectType {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  description String?
  // When false, creating a project of this type skips the plan quota check,
  // module attachment and seed-task creation (a bare project).
  isPlanAdd   Boolean @default(true) @map("is_plan_add")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plans     Plan[]
  projects  Project[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("project_type")
}

model ProjectMember {
  id        String           @id @default(uuid())
  projectId String           @map("project_id")
  userId    String           @map("user_id")
  roleId    String           @map("role_id")
  invitedBy String?          @map("invited_by")
  status    MembershipStatus @default(invited)
  joinedAt  DateTime         @default(now()) @map("joined_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    UserRole @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_member")
}

// ---------------------------------------------------------------------------
// Modules: catalog (Module) + per-project instance (ModuleInstance)
// ---------------------------------------------------------------------------

model Module {
  id               String  @id @default(uuid())
  workspaceId      String  @map("workspace_id")
  planId           String  @map("plan_id")
  key              String
  name             String
  defaultTaskLimit Int     @default(10) @map("default_task_limit")
  isDefault        Boolean @default(false) @map("is_default")
  isActive         Boolean @default(true) @map("is_active")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  instances ModuleInstance[]

  // A module belongs to a plan; the same key may exist under different plans.
  @@unique([planId, key])
  @@index([workspaceId])
  @@index([planId])
  @@map("module")
}

model ModuleInstance {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  moduleId  String   @map("module_id")
  taskLimit Int      @map("task_limit")
  // Count of tasks created beyond taskLimit (billable/tracked add-ons instead
  // of a hard rejection).
  addonTask Int      @default(0) @map("addon_task")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id])
  tasks   Task[]

  @@unique([projectId, moduleId])
  @@index([projectId])
  @@map("module_instance")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  moduleInstanceId String?   @map("module_instance_id")
  name             String
  prefix           String?
  description      String?
  startDate        DateTime? @map("start_date")
  dueDate          DateTime? @map("due_date")
  statusId         String?   @map("status_id")
  priorityId       String?   @map("priority_id")
  assigneeId       String?   @map("assignee_id")
  createdBy        String    @map("created_by")
  position         Int       @default(0)
  estimateHours    Float?    @map("estimate_hours")
  completedHours   Float?    @map("completed_hours")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleInstance ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  status         TicketStatus?   @relation(fields: [statusId], references: [id])
  priority       Priority?       @relation(fields: [priorityId], references: [id])
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator        User            @relation("TaskCreator", fields: [createdBy], references: [id])
  comments       Comment[]

  @@index([projectId])
  @@index([moduleInstanceId])
  @@index([statusId])
  @@index([priorityId])
  @@index([assigneeId])
  @@map("task")
}

// ---------------------------------------------------------------------------
// Incidents (standalone tickets for implementation flaws — scoped to a
// project, not bound to any task)
// ---------------------------------------------------------------------------

model Incident {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  projectId   String         @map("project_id")
  title       String
  description String?
  status      IncidentStatus @default(open)
  reportedBy  String         @map("reported_by")
  assigneeId  String?        @map("assignee_id")
  estimateHours  Float?      @map("estimate_hours")
  completedHours Float?      @map("completed_hours")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter  User      @relation("IncidentReporter", fields: [reportedBy], references: [id])
  assignee  User?     @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  comments  Comment[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("incident")
}

// ---------------------------------------------------------------------------
// Comments (on tasks and incidents, with @mentions by email)
// ---------------------------------------------------------------------------

model Comment {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  // Exactly one parent is set: a task comment or an incident comment.
  taskId      String?  @map("task_id")
  incidentId  String?  @map("incident_id")
  body        String
  authorId    String   @map("author_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  incident  Incident?        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author    User             @relation("CommentAuthor", fields: [authorId], references: [id])
  mentions  CommentMention[]

  @@index([workspaceId])
  @@index([taskId])
  @@index([incidentId])
  @@map("comment")
}

// Users tagged in a comment (resolved from their email at creation time).
model CommentMention {
  commentId String @map("comment_id")
  userId    String @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentMentions", fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mention")
}

// ---------------------------------------------------------------------------
// Priorities (per workspace, configurable list)
// ---------------------------------------------------------------------------

model Priority {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  color       String?
  order       Int     @default(0)
  isDefault   Boolean @default(false) @map("is_default")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("priority")
}

// ---------------------------------------------------------------------------
// Ticket statuses (per workspace, configurable pipeline)
// ---------------------------------------------------------------------------

model TicketStatus {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  name        String
  color       String?
  order       Int            @default(0)
  isDefault   Boolean        @default(false) @map("is_default")
  category    StatusCategory @default(todo)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("ticket_status")
}

// ---------------------------------------------------------------------------
// Activity log (audit trail for task/incident lifecycle + comments)
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  // What kind of thing this entry is about: 'task' | 'incident'.
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  // 'created' | 'updated' | 'status_changed' | 'deleted' | 'comment_added'
  action      String
  userId      String   @map("user_id")
  // Action-specific details, e.g. { changes: { statusId: { from, to } } }.
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User       @relation("ActivityLogActor", fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([entityType, entityId])
  @@map("activity_log")
}
